{
  "name": "format-conversion",
  "version": "0.2.0",
  "description": "A lightweight, plugin-based document format conversion library for Node.js",
  "keywords": [
    "format",
    "conversion",
    "convert",
    "markdown",
    "html",
    "text",
    "document"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "peerDependencies": {
    "docx": ">=9.0.0",
    "fflate": ">=0.8.0",
    "mammoth": ">=1.8.0",
    "pdf-parse": ">=2.0.0",
    "pdfkit": ">=0.15.0",
    "pptxgenjs": ">=4.0.0",
    "word-extractor": ">=1.0.0",
    "xlsx": ">=0.18.5"
  },
  "peerDependenciesMeta": {
    "docx": { "optional": true },
    "fflate": { "optional": true },
    "mammoth": { "optional": true },
    "pdf-parse": { "optional": true },
    "pdfkit": { "optional": true },
    "pptxgenjs": { "optional": true },
    "word-extractor": { "optional": true },
    "xlsx": { "optional": true }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "docx": "^9.14.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  }
}
